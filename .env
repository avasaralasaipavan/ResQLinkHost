# Local development config. Copy of .env.example with real values.

# ---- Core ----
SECRET_KEY=change-me
BASE_URL=http://127.0.0.1:5000

# ---- OTP settings ----
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RATE_LIMIT_COUNT=5
OTP_RATE_LIMIT_WINDOW_MINUTES=15
OTP_COOLDOWN_SECONDS=30

# ---- Email (Flask-Mail via SMTP) ----
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=1
MAIL_USE_SSL=0
MAIL_USERNAME=pavan@sujainfo.com
MAIL_PASSWORD=jcdu lvos khei czlx
MAIL_FROM=ResQLink <pavan@sujainfo.com>
MAIL_SUPPRESS_SEND=0
MAIL_DEBUG=1

# ---- Default QR access limitation ----
DEFAULT_ACCESS_LIMIT_COUNT=3
DEFAULT_ACCESS_LIMIT_WINDOW_MINUTES=60

# ---- Bootstrap admin account ----
ADMIN_EMAIL=admin@resqlink.app
ADMIN_PASSWORD=admin123