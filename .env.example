# Copy this file to `.env` and edit the values below.
# Everything your app reads lives here — change any value and restart the app.
#
# SECURITY: never commit this file to git. It contains secrets.

# ---- Core ----
# Use a long random string. Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me
# Public URL of the app. Used to build the QR payload.
BASE_URL=http://127.0.0.1:5000

# ---- OTP settings ----
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RATE_LIMIT_COUNT=5
OTP_RATE_LIMIT_WINDOW_MINUTES=15
OTP_COOLDOWN_SECONDS=30

# ---- Email (Flask-Mail via SMTP). Defaults target Gmail SMTP. ----
# Gmail will NOT accept your normal password. You must use an App Password:
#   Google account > Security > 2-Step Verification (turn ON) > App passwords
# Then paste that 16-character code as MAIL_PASSWORD.
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=1
MAIL_USE_SSL=0
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-16-character-app-password
MAIL_FROM=ResQLink <your-email@gmail.com>
MAIL_SUPPRESS_SEND=0
# Set MAIL_DEBUG=0 so OTPs stop appearing on-screen in production.
MAIL_DEBUG=1

# ---- Default QR access limitation (owner configurable) ----
DEFAULT_ACCESS_LIMIT_COUNT=3
DEFAULT_ACCESS_LIMIT_WINDOW_MINUTES=60

# ---- Bootstrap admin account (created on first run) ----
ADMIN_EMAIL=admin@resqlink.app
ADMIN_PASSWORD=change-me